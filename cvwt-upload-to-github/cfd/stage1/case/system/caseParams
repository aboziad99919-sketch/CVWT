/*  CVWT stage-1 | OpenFOAM.org 12 (foamRun -solver incompressibleFluid) | generated template  */
FoamFile
{
    format      ascii;
    class       dictionary;
    object      caseParams;
}

// All sweep variables live here; make_sweep.py writes one copy per case.  Units SI, rig scale 1:12.
U_IN        @@U_IN@@;          // approach speed at the CVWT [m/s]
K_IN        @@K_IN@@;          // 1.5 (U I)^2, I = 5 % (ASSUMED)
OMEGA_IN    @@OMEGA_IN@@;      // sqrt(k)/(Cmu^0.25 l), l = 0.01 m (ASSUMED)
D_COEFF     @@D_COEFF@@;       // Darcy d [1/m2]  (Ergun, candidate @@FILTER_ID@@)
F_COEFF     @@F_COEFF@@;       // Forchheimer f [1/m]
FILTER_Z0   @@FILTER_Z0@@;     // porous bed bottom [m]
BORE_R      @@BORE_R@@;        // housing bore radius [m]; the porous zone is cut 0.2 mm oversize
FILTER_Z1   @@FILTER_Z1@@;     // porous bed top [m]  (bore plenum runs z = 0.005 to 0.058)
// Flow-measuring interface just above the bed. topoSet builds two thin cylindrical cell slabs
// and makes a faceZone of the faces they share, so the measured surface is the bore cross-section
// and nothing outside the housing can contribute. Slabs are >=2 cells thick at every mesh level.
QZ_LO       @@QZ_LO@@;         // bottom of the lower slab [m]
QZ_MID      @@QZ_MID@@;        // slab interface: the measuring surface [m]
QZ_HI       @@QZ_HI@@;         // top of the upper slab [m]
LVL         @@LVL@@;           // surface refinement level near CVWT core (medium = 5 -> 0.625 mm)
LVL_1       @@LVL_1@@;
LVL_2       @@LVL_2@@;
LVL_3       @@LVL_3@@;
