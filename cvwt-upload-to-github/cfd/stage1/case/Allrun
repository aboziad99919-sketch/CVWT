#!/usr/bin/env bash
# CVWT stage-1 case. DRY RUN BY DEFAULT: prints every step. Execute with:  ./Allrun --run [NPROCS]
# Requires OpenFOAM.org 12 sourced (source /opt/openfoam12/etc/bashrc).
set -euo pipefail
cd "$(dirname "$0")"
RUN=0; [[ "${1:-}" == "--run" ]] && RUN=1
NP="${2:-1}"
MAX_CELLS="${MAX_CELLS:-8000000}"
# log is named after the application, not the launcher: "mpirun -np N app" must still write log.app
step() { echo "+ $*"; if [[ $RUN == 1 ]]; then app=$1; [[ $app == mpirun ]] && app=$4; name=$(echo "$app" | tr -d './'); "$@" > "log.$name" 2>&1 || { echo "FAILED: $* (see log.$name)"; exit 1; }; fi; }
par()  { if [[ $NP -gt 1 ]]; then step mpirun -np "$NP" "$@" -parallel; else step "$@"; fi; }
[[ -f log.foamRun ]] && { echo "log.foamRun exists - this case already ran; copy the case instead of re-running here."; exit 1; }

# Dictionary smoke test, 2 seconds. foamDictionary -expand resolves every #include and
# #includeFunc, so a function object that does not exist, or a token that was never substituted,
# fails HERE instead of ten minutes later when foamRun finally reads controlDict. Group J lost a
# whole five-case run to exactly that.
if [[ $RUN == 1 ]]; then
  for d in system/controlDict system/topoSetDict constant/fvModels; do
    foamDictionary "$d" -expand > /dev/null 2> "log.dict.$(basename "$d")" || {
      echo "DICTIONARY REJECTED: $d"; cat "log.dict.$(basename "$d")"; exit 2; }
  done
  # the pattern is written as a regex so this file does not itself contain the token it hunts for
  grep -rlE '@{2}' system/ constant/ 2>/dev/null | while read -r f; do
    echo "UNSUBSTITUTED TOKEN in $f"; grep -nE '@{2}' "$f"; exit 2; done
  echo "dictionaries expand cleanly"
fi

step surfaceFeatures
step blockMesh
[[ $NP -gt 1 ]] && step decomposePar -copyZero
par snappyHexMesh -overwrite
par topoSet
par checkMesh
if [[ $RUN == 1 ]]; then
  N=$(grep -m1 -E "^\s*cells:" log.checkMesh | awk '{print $2}'); echo "cells = $N"
  (( N <= MAX_CELLS )) || { echo "REFUSED: $N cells > MAX_CELLS=$MAX_CELLS"; exit 3; }
  grep -q "Failed [0-9]* mesh checks" log.checkMesh && echo "WARNING: checkMesh reports failed checks - review before trusting results"
  # Group I has no outletFilter patch at all: its intake is an annular slot in the housing wall,
  # measured on a cut plane instead. The marker file is written by make_sweep.py for those cases.
  if [[ ! -f system/INTERNAL_INTAKE ]]; then
    grep -A3 "outletFilter" constant/polyMesh/boundary | grep -q "nFaces *[1-9]" || [[ $NP -gt 1 ]] || { echo "outletFilter has no faces - slots not resolved; refine slotBox"; exit 4; }
  else
    grep -q "intakeSlot\|housing" constant/polyMesh/boundary || { echo "housing surface missing from the mesh"; exit 4; }
  fi
fi
par foamRun
[[ $NP -gt 1 ]] && step reconstructPar -latestTime
step foamToVTK -latestTime
echo "done (run=$RUN)."
